# Environment variables for fetch_quarter_splits.py
# Copy to .env and fill in values, or export directly before running.

# Gluetun VPN control API — enables automatic VPN rotation on HTTP 403 (hard IP block).
# Set to the Gluetun control server URL when running inside Docker with gluetun sidecar.
# Leave empty to disable rotation (fetcher will fall back to exponential wait on 403).
# Example (Docker Compose): GLUETUN_CTRL_URL=http://localhost:8000
GLUETUN_CTRL_URL=

# Session rate-limiting controls for fetch_quarter_splits.py
# Number of successful page fetches between cooldown sleeps (default: 100)
SESSION_COOLDOWN_PAGES=100

# Cooldown sleep duration in seconds (default: 300 = 5 minutes)
SESSION_COOLDOWN_SEC=300

# Maximum backoff for HTTP 403 responses in seconds (default: 600)
MAX_403_BACKOFF_SEC=600
