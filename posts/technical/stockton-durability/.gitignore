# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Data artifacts — regenerate via make cohort-pg / population-fetch
data/game_logs.parquet
data/population_cohort.csv
data/quarter_splits_*.parquet
data/*_permutation.parquet
data/e1_*.parquet
data/e2_*.parquet
data/e4_*.parquet
data/e5_*.parquet
data/e7_*.csv
data/cohort_summary.csv
data/fetch_gaps.csv
data/*.lock

# HTML cache — regenerate on re-fetch
data/html_cache/

# Figures are committed intentionally — blog posts reference them by path
# and Quarto rendering requires them at build time.
