# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# IPython Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# dotenv
.env

# virtualenv
venv/
ENV/

# Spyder project settings
.spyderproject

# Rope project settings
.ropeproject

# folders
pelican-plugins/
pelican-themes/
output/theme/
.content-archive/
.drafts/

# files
*.DS_Store
*.zip

# folders
.vscode/
.idea/

# Quarto build artifacts
_site/
.quarto/
# _freeze/ is intentionally tracked: commit it so CI can publish without
# a 'blog' Jupyter kernel.  Render locally when notebook source changes.
/.quarto/
**/*.quarto_ipynb
cache/

# Jupyter execution cache
.jupyter_cache/
**/.jupyter_cache/

# Data-fetch script artifacts
downloaded_files/
**/downloaded_files/

# R session history
*.Rhistory

# Local tooling / session config
.aider.conf.yml
.notify.toml
commit_msg.md

# EPL analysis data — commit analysis outputs (parquets + JSONs); keep raw
# per-season match files and the CSV copy out.  The analysis outputs are
# small (<400 KB total) and must be present for Quarto to re-render the post
# when the QMD source changes (see _freeze/ strategy in #18).
posts/blog/epl-2026-27-predictions/data/*.csv
posts/blog/epl-2026-27-predictions/data/matches/

# Stockton durability — commit analysis outputs (permutation parquets, figures, CSVs)
# Raw game log input: large binary, grows with each fetch run — regenerable from BRef
posts/technical/stockton-durability/data/html_cache/
posts/technical/stockton-durability/data/game_logs.parquet
# Lock file is a runtime artifact for concurrent write safety — never commit
posts/technical/stockton-durability/data/game_logs.parquet.lock
# VPN configs contain private keys — never commit
posts/technical/stockton-durability/vpn/
# Test-generated permutation parquets (cohort="test*") are test artifacts
posts/technical/stockton-durability/data/e1_test*.parquet
posts/technical/stockton-durability/data/e2_test*.parquet
posts/technical/stockton-durability/data/e4_test*.parquet
posts/technical/stockton-durability/data/e5_test*.parquet
# Keep __pycache__ out
posts/technical/stockton-durability/__pycache__/
posts/technical/stockton-durability/tests/__pycache__/

# Handoff packets — SESSION files committed; other working docs ignored
docs/handoffs/*
!docs/handoffs/.gitkeep
!docs/handoffs/SESSION-*.md
